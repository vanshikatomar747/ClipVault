# API URL Configuration for ClipVault Frontend
# Change this depending on where/how you are running the application:

# 1. Web Browser (Default localhost)
VITE_API_URL=http://localhost:4000/api

# 2. Android Emulator (accessing host machine)
# VITE_API_URL=http://10.0.2.2:4000/api

# 3. iOS Simulator
# VITE_API_URL=http://localhost:4000/api

# 4. Physical Mobile Device (Android or iOS)
# Replace with your developer machine's local IP address (ensure both devices are on the same Wi-Fi)
# VITE_API_URL=http://192.168.1.100:4000/api
